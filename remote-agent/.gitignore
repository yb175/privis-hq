# Production .gitignore for remote-agent

# Environment variables & secrets (CRITICAL: API keys must never enter git)
.env
.env.*
!.env.example
*.pem
*.key
*.secret
*.secrets
credentials.json
keys.json

# Dependencies & build outputs
node_modules/
dist/
build/
*.tsbuildinfo
*.js.map
*.mjs.map

# Logs, trace dumps & session recordings
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
session-dumps/
*.trace.json
debug-*.json

# Testing & Coverage artifacts
coverage/
.nyc_output/
test-results/
.pytest_cache/

# OS & Editor temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.tmp
