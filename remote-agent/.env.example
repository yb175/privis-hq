# PRIVIS Remote Agent & Model Router Configuration
#
# SECURITY: these provider keys are SERVER-SIDE ONLY. The browser extension never
# holds, persists, or transmits API keys — it only knows this server's URL, an
# optional auth token, and a model preference (see extension/src/settings/models.ts).

# Active Model ("chatgpt" or "gemini", defaults to "chatgpt")
PRIVIS_MODEL=chatgpt

# OpenAI / OpenAI-compatible configuration
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini configuration
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-3.5-flash-lite-preview

# SerpAPI — server-side destination discovery for the 'search' action.
# When the agent doesn't know a site's URL it emits {"type":"search","query":
# "..."}; THIS server calls SerpAPI and answers with a navigate. Without a key
# the search action degrades to ask_human (everything else still works).
# Free tier: ~100 searches/month at https://serpapi.com keys are SERVER-SIDE ONLY.
# SERPAPI_KEY=your_serpapi_key_here

# Security (recommended before exposing beyond localhost)
# AGENT_AUTH_TOKEN=change-me       # /plan then requires 'Authorization: Bearer <token>'
# AGENT_ALLOWED_ORIGINS=chrome-extension://your-extension-id,https://your-portal
#                                  # default allowlist: localhost, 127.0.0.1, chrome-extension://
