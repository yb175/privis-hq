{
  "name": "privacy-browser-agent",
  "version": "0.1.0",
  "description": "PRIVIS: On-device Visual Perception for Light-weight Browser Agents",
  "type": "module",
  "scripts": {
    "build": "esbuild background/service-worker.ts utils/dom-extractor.ts privacy/sanitizer/structural-redact.ts content/capture-content.ts --bundle --format=iife --outdir=dist",
    "typecheck": "tsc --noEmit",
    "watch": "npm run build -- --watch"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
