{
  "name": "privacy-browser-agent",
  "version": "0.1.0",
  "description": "PRIVIS: On-device Visual Perception for Light-weight Browser Agents",
  "type": "module",
  "scripts": {
    "build": "node scripts/copy-ort-assets.mjs && esbuild background/service-worker.ts content/capture-content.ts privacy/engine/vision/ort-runtime.ts privacy/engine/vision/face-detector.ts privacy/engine/vision/face-pipeline.ts privacy/engine/fuse.ts --bundle --format=iife --loader:.md=text --outdir=dist && esbuild extension/src/popup/popup.ts --bundle --format=iife --loader:.md=text --outfile=dist/popup/popup.js && esbuild extension/src/offscreen/offscreen.ts --bundle --format=iife --loader:.md=text --outfile=dist/offscreen/offscreen.js",
    "test:unit": "npm run test:cba && npm run test:format-value && npm run test:goal-tokenize && npm run test:local-intent && npm run test:router && npm run test:guard && npm run test:agent-phase4 && npm run test:advanced-phase13 && npm run test:geometry && npm run test:navigate && npm run test:quota && npm run test:settings && npm run test:popup && npm run test:transparency-buffer && npm run test:transparency-digest && npm run test:ux-phase12 && npm run test:perf-phase11 && npm run test:detection && npm run test:lexical && npm run test:validators && npm run test:placeholders && npm run test:vault && npm run test:vault-phase5 && npm run test:ocr-regions && npm run test:text-chunks && npm run test:gate && npm run test:eval-phase7 && npm run test:vision && npm run test:face",
    "test:integration": "npm run test:goal && npm run test:loop && npm run test:privacy-contract && npm run test:transparency-purity && npm run test:face-pipeline && npm run test:release-phase8",
    "test:browser": "npm run test:session-e2e && npm run test:browser-phase6 && npm run test:chrome-phase9",
    "test:security": "npm run test:privacy && npm run test:security-phase10",
    "test:vision": "npm run build && esbuild test/unit/ml/vision/ort-runtime.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-ort-runtime.mjs && node dist-test/test-ort-runtime.mjs",
    "test:face": "npm run build && esbuild test/unit/ml/vision/face-detector.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-face-detector.mjs && node dist-test/test-face-detector.mjs",
    "test:face-pipeline": "npm run build && esbuild test/integration/ml/vision/face-pipeline.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-face-pipeline.mjs && node dist-test/test-face-pipeline.mjs",
    "test:privacy": "npm run build && esbuild test/security/privacy/privacy-boundary.test.ts --bundle --format=esm --platform=node --loader:.md=text --outfile=dist-test/test-privacy-boundary.mjs && node dist-test/test-privacy-boundary.mjs",
    "test:cba": "esbuild test/unit/agent/agent-action.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-agent-action.mjs && node dist-test/test-agent-action.mjs",
    "test:navigate": "esbuild test/unit/browser/navigate.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-navigate.mjs && node dist-test/test-navigate.mjs",
    "test:router": "esbuild test/unit/agent/router.test.ts --bundle --format=esm --platform=node --loader:.md=text --outfile=dist-test/test-router.mjs && node dist-test/test-router.mjs",
    "test:guard": "esbuild test/unit/agent/packager-guard.test.ts --bundle --format=esm --platform=node --loader:.md=text --outfile=dist-test/test-packager-guard.mjs && node dist-test/test-packager-guard.mjs",
    "test:popup": "esbuild test/unit/extension/popup-session.test.ts --bundle --format=esm --platform=node --loader:.md=text --outfile=dist-test/test-popup-session.mjs && node dist-test/test-popup-session.mjs",
    "test:loop": "esbuild test/integration/agent/session-loop.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-session-loop.mjs && node dist-test/test-session-loop.mjs",
    "test:session-e2e": "esbuild test/browser/e2e/session-e2e.test.ts --bundle --format=esm --platform=node --loader:.md=text --outfile=dist-test/test-session-e2e.mjs && node dist-test/test-session-e2e.mjs",
    "test:settings": "esbuild test/unit/extension/settings.test.ts --bundle --format=esm --platform=node --loader:.md=text --outfile=dist-test/test-settings.mjs && node dist-test/test-settings.mjs",
    "test:quota": "esbuild test/unit/browser/screenshot-quota.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-screenshot-quota.mjs && node dist-test/test-screenshot-quota.mjs",
    "test:goal": "esbuild test/integration/agent/run-goal.test.ts --bundle --format=esm --platform=node --loader:.md=text --outfile=dist-test/test-run-goal.mjs && node dist-test/test-run-goal.mjs",
    "test:privacy-contract": "esbuild test/integration/privacy/privacy-contract.test.ts --bundle --format=esm --platform=node --loader:.md=text --outfile=dist-test/test-privacy-contract.mjs && node dist-test/test-privacy-contract.mjs",
    "test:transparency-purity": "esbuild test/integration/privacy/transparency-purity.test.ts --bundle --format=esm --platform=node --loader:.md=text --outfile=dist-test/test-transparency-purity.mjs && node dist-test/test-transparency-purity.mjs",
    "test:transparency-buffer": "esbuild test/unit/extension/transparency-buffer.test.ts --bundle --format=esm --platform=node --loader:.md=text --outfile=dist-test/test-transparency-buffer.mjs && node dist-test/test-transparency-buffer.mjs",
    "test:transparency-digest": "esbuild test/unit/extension/transparency-digest.test.ts --bundle --format=esm --platform=node --loader:.md=text --outfile=dist-test/test-transparency-digest.mjs && node dist-test/test-transparency-digest.mjs",
    "test:transparency": "npm run test:transparency-purity && npm run test:transparency-buffer && npm run test:transparency-digest",
    "test:validators": "esbuild test/unit/privacy/validators.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-validators.mjs && node dist-test/test-validators.mjs",
    "test:lexical": "esbuild test/unit/privacy/lexical.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-lexical.mjs && node dist-test/test-lexical.mjs",
    "test:placeholders": "esbuild test/unit/privacy/placeholders.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-placeholders.mjs && node dist-test/test-placeholders.mjs",
    "test:gate": "esbuild test/unit/privacy/gate.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-gate.mjs && node dist-test/test-gate.mjs",
    "test:vault": "esbuild test/unit/privacy/vault.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-vault.mjs && node dist-test/test-vault.mjs",
    "test:geometry": "esbuild test/unit/browser/geometry.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-geometry.mjs && node dist-test/test-geometry.mjs",
    "test:ocr-regions": "esbuild test/unit/privacy/ocr-regions.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-ocr-regions.mjs && node dist-test/test-ocr-regions.mjs",
    "test:text-chunks": "esbuild test/unit/privacy/text-chunks.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-text-chunks.mjs && node dist-test/test-text-chunks.mjs",
    "test:format-value": "esbuild test/unit/agent/format-value.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-format-value.mjs && node dist-test/test-format-value.mjs",
    "test:goal-tokenize": "esbuild test/unit/agent/goal-tokenize.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-goal-tokenize.mjs && node dist-test/test-goal-tokenize.mjs",
    "test:local-intent": "esbuild test/unit/agent/local-intent.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-local-intent.mjs && node dist-test/test-local-intent.mjs",
    "test:detection": "esbuild test/unit/privacy/detection-engine.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-detection-engine.mjs && node dist-test/test-detection-engine.mjs",
    "test:agent-phase4": "esbuild test/unit/agent/phase4-agent.test.ts --bundle --format=esm --platform=node --loader:.md=text --outfile=dist-test/test-phase4-agent.mjs && node dist-test/test-phase4-agent.mjs",
    "test:vault-phase5": "esbuild test/unit/privacy/phase5-vault.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-phase5-vault.mjs && node dist-test/test-phase5-vault.mjs",
    "test:browser-phase6": "esbuild test/browser/e2e/phase6-browser.test.ts --bundle --format=esm --platform=node --loader:.md=text --outfile=dist-test/test-phase6-browser.mjs && node dist-test/test-phase6-browser.mjs",
    "test:eval-phase7": "esbuild test/unit/ml/evaluation/phase7-eval.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-phase7-eval.mjs && node dist-test/test-phase7-eval.mjs",
    "test:release-phase8": "esbuild test/integration/extension/phase8-release.test.ts --bundle --format=esm --platform=node --loader:.md=text --outfile=dist-test/test-phase8-release.mjs && node dist-test/test-phase8-release.mjs",
    "test:chrome-phase9": "esbuild test/browser/chrome/phase9-chrome.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-phase9-chrome.mjs && node dist-test/test-phase9-chrome.mjs",
    "test:security-phase10": "esbuild test/security/agent/phase10-security.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-phase10-security.mjs && node dist-test/test-phase10-security.mjs",
    "test:perf-phase11": "esbuild test/unit/shared/phase11-perf.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-phase11-perf.mjs && node dist-test/test-phase11-perf.mjs",
    "test:ux-phase12": "esbuild test/unit/extension/phase12-ux.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-phase12-ux.mjs && node dist-test/test-phase12-ux.mjs",
    "test:advanced-phase13": "esbuild test/unit/agent/phase13-advanced-agent.test.ts --bundle --format=esm --platform=node --outfile=dist-test/test-phase13-advanced-agent.mjs && node dist-test/test-phase13-advanced-agent.mjs",
    "serve:agent": "esbuild remote-agent/server.ts --bundle --format=esm --platform=node --loader:.md=text --outfile=dist/remote-agent/server.mjs && node dist/remote-agent/server.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration && npm run test:browser && npm run test:security",
    "typecheck": "tsc --noEmit",
    "watch": "npm run build -- --watch"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "onnxruntime-web": "^1.29.0"
  }
}
