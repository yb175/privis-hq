{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "./dist",
    "types": ["chrome"]
  },
  "include": [
    "background/**/*",
    "content/**/*",
    "executor/**/*",
    "privacy/**/*",
    "remote/**/*",
    "remote-agent/**/*",
    "types/**/*",
    "utils/**/*",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
